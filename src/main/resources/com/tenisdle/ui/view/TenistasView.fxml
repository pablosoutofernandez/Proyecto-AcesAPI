<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.tenisdle.ui.controller.TenistasController"
            styleClass="pantalla">

    <!-- Arriba: busquedas, filtros y ordenaciones.
         Cada control lanza una consulta distinta: no se combinan entre si -->
    <top>
        <HBox fx:id="barra" spacing="10" alignment="CENTER_LEFT" styleClass="barra-herramientas">
            <TextField fx:id="txtNombre" promptText="Nombre..." prefWidth="150" onAction="#onBuscarNombre"/>
            <Button text="Buscar" onAction="#onBuscarNombre"/>
            <Separator orientation="VERTICAL"/>
            <ComboBox fx:id="cmbPais" promptText="Pais" onAction="#onFiltrarPais"/>
            <ComboBox fx:id="cmbMano" promptText="Mano" onAction="#onFiltrarMano"/>
            <Separator orientation="VERTICAL"/>
            <Label text="Top"/>
            <Spinner fx:id="spTop" prefWidth="80" editable="true"/>
            <Button text="Ver top" onAction="#onTop"/>
            <Separator orientation="VERTICAL"/>
            <ComboBox fx:id="cmbOrden" promptText="Ordenar por" onAction="#onOrdenar"/>
            <Separator orientation="VERTICAL"/>
            <Button text="Ver todos" onAction="#onVerTodos"/>
        </HBox>
    </top>

    <!-- Centro: resultado de la ultima consulta -->
    <center>
        <TableView fx:id="tabla">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colNombre" text="Nombre"/>
                <TableColumn fx:id="colPais" text="Pais"/>
                <TableColumn fx:id="colEdad" text="Edad"/>
                <TableColumn fx:id="colMano" text="Mano"/>
                <TableColumn fx:id="colRanking" text="Ranking"/>
                <TableColumn fx:id="colPuntos" text="Puntos"/>
            </columns>
        </TableView>
    </center>

    <!-- Derecha: CRUD (buscar por id, nuevo, modificar, borrar) -->
    <right>
        <VBox fx:id="panel" spacing="8" styleClass="panel-lateral">
            <Label text="Buscar por id" styleClass="panel-titulo"/>
            <TextField fx:id="txtId" promptText="Id del tenista" onAction="#onLeer"/>
            <Button text="Leer" maxWidth="Infinity" onAction="#onLeer"/>

            <Separator/>

            <Label text="Gestion" styleClass="panel-titulo"/>
            <Button text="Nuevo tenista" styleClass="boton-principal" maxWidth="Infinity" onAction="#onNuevo"/>
            <Button fx:id="btnModificar" text="Modificar seleccionado" maxWidth="Infinity" onAction="#onModificar"/>
            <Button fx:id="btnBorrar" text="Borrar seleccionado" maxWidth="Infinity" onAction="#onBorrar"/>

            <Separator/>

            <!-- Estadisticas: edadMedia(), listarPaises() y contarPorPais() -->
            <Label text="Estadisticas" styleClass="panel-titulo"/>
            <Label fx:id="lblEdadMedia" text="Edad media: -"/>
            <Label fx:id="lblNumPaises" text="Paises: -"/>
            <TableView fx:id="tablaPaises" VBox.vgrow="ALWAYS" prefHeight="150">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colPaisEst" text="Pais" sortable="false"/>
                    <TableColumn fx:id="colNumTenistas" text="Tenistas" sortable="false"/>
                </columns>
            </TableView>
        </VBox>
    </right>

    <!-- Abajo: numero de resultados y exportar esas mismas filas a CSV -->
    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="barra-inferior">
            <Label fx:id="lblResultados" styleClass="estado"/>
            <!-- Hueco que crece y empuja el boton a la derecha -->
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnExportar" text="Exportar CSV" disable="true" onAction="#onExportarCsv"/>
        </HBox>
    </bottom>
</BorderPane>
