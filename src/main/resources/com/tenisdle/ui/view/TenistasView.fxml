<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.tenisdle.ui.controller.TenistasController"
            styleClass="pantalla">

    <!-- Arriba: barra de busquedas, filtros y ordenaciones (se ira completando) -->
    <top>
        <HBox fx:id="barra" spacing="10" alignment="CENTER_LEFT" styleClass="barra-herramientas">
            <Button text="Ver todos" onAction="#onVerTodos"/>
        </HBox>
    </top>

    <!-- Centro: resultado de la ultima consulta -->
    <center>
        <TableView fx:id="tabla">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colNombre" text="Nombre"/>
                <TableColumn fx:id="colPais" text="Pais"/>
                <TableColumn fx:id="colEdad" text="Edad"/>
                <TableColumn fx:id="colMano" text="Mano"/>
                <TableColumn fx:id="colRanking" text="Ranking"/>
                <TableColumn fx:id="colPuntos" text="Puntos"/>
            </columns>
        </TableView>
    </center>

    <!-- Abajo: numero de resultados -->
    <bottom>
        <Label fx:id="lblResultados" styleClass="estado"/>
    </bottom>
</BorderPane>
